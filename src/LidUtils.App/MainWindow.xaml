<Window x:Class="LidUtils.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LET IT DIE Utilities" Width="1240" Height="820" MinWidth="960" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="#11141A" Foreground="#F4F6FA" Loaded="OnLoaded" Closing="OnClosing">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="LET IT DIE" FontSize="13" FontWeight="SemiBold" Foreground="#FF5A52"/>
                <TextBlock Text="Utilities" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock Text="Database setup, save editing, and application preferences." Foreground="#AEB7C6"/>
            </StackPanel>
            <ProgressBar Grid.Column="1" Width="150" Height="5" IsIndeterminate="True" VerticalAlignment="Center" Visibility="{Binding BusyVisibility}"/>
        </Grid>
        <TabControl Grid.Row="2" Background="#171B22" BorderBrush="#343C49">
            <TabItem Header="Save editor">
                <Grid Margin="14" DataContext="{Binding SaveEditor}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="*" MinHeight="120"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding SavePath, Mode=OneWay}" IsReadOnly="True" Padding="10,7" Background="#1B2029" Foreground="#E8ECF3" BorderBrush="#343C49"/><Button Grid.Column="1" Content="Browse…" Margin="10,0,0,0" IsEnabled="{Binding CanInteract}" Click="OnBrowseSave"/><Button Grid.Column="2" Content="Reload" Margin="8,0,0,0" IsEnabled="{Binding CanInteract}" Click="OnReloadSave"/><Button Grid.Column="3" Content="ⓘ" FontSize="12" Padding="6" Margin="8,0,0,0" ToolTip="Save file details" IsEnabled="{Binding HasSnapshot}" Click="OnShowSaveInfo"/></Grid>
                    <Border Grid.Row="2" Padding="12" CornerRadius="5" Background="#1B2029" BorderBrush="#343C49" BorderThickness="1"><StackPanel><TextBlock Text="{Binding StatusTitle}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding StatusDetails}" Foreground="#C5CCD7" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel></Border>
                    <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="10,7" ToolTip="Search JSON path, value, or type"/><Button Grid.Column="1" Content="Clear filter" IsEnabled="{Binding HasSearchText}" Click="OnClearSaveSearch" Margin="8,0,0,0"/><TextBlock Grid.Column="2" Text="{Binding ValuesSummary}" Foreground="#AEB7C6" VerticalAlignment="Center" Margin="12,0,0,0"/></Grid>
                    <Grid Grid.Row="6"><Grid.ColumnDefinitions><ColumnDefinition Width="2.2*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <DataGrid ItemsSource="{Binding DisplayedValues}" SelectedItem="{Binding SelectedValue}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"><DataGrid.Columns><DataGridTextColumn Header="JSON path" Binding="{Binding DisplayPath}" Width="*" SortMemberPath="DisplayPath"/><DataGridTextColumn Header="Type" Binding="{Binding TypeLabel}" Width="90" SortMemberPath="TypeLabel"/><DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="220" SortMemberPath="Value"/></DataGrid.Columns></DataGrid>
                        <Border Grid.Column="2" Padding="15" Background="#1B2029" BorderBrush="#343C49" BorderThickness="1" CornerRadius="5"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Edit selected value" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedValue.DisplayPath, TargetNullValue=Select a value}" Margin="0,10,0,0" FontFamily="Consolas" TextWrapping="Wrap"/><TextBlock Text="{Binding SelectedValue.TypeLabel, StringFormat=Type: {0}}" Foreground="#AEB7C6" Margin="0,5,0,0"/><TextBlock Text="Original value" FontWeight="SemiBold" Margin="0,12,0,0"/><TextBox Text="{Binding SelectedValue.Value, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="90" VerticalScrollBarVisibility="Auto" Margin="0,5,0,0" Padding="8,5"/><TextBlock Text="Proposed value" FontWeight="SemiBold" Margin="0,12,0,0"/><TextBox Text="{Binding ProposedValue, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" MaxHeight="110" VerticalScrollBarVisibility="Auto" Margin="0,5,0,0" Padding="8,5"/><TextBlock Text="{Binding EditorError}" Foreground="#FF7770" TextWrapping="Wrap" Margin="0,5,0,0"/><TextBlock Text="{Binding EditorWarning}" Foreground="#FFB55A" TextWrapping="Wrap" Margin="0,4,0,0"/><StackPanel Orientation="Horizontal" Margin="0,9,0,0"><Button Content="Stage change" IsEnabled="{Binding CanStage}" Click="OnStageSaveChange"/><Button Content="Reset" IsEnabled="{Binding HasSelectedValue}" Click="OnResetSaveChange" Margin="8,0,0,0"/></StackPanel><Separator Margin="0,14"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding PendingChanges.Count, StringFormat=Pending changes: {0}}" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Grid.Column="1" Content="Reset all" IsEnabled="{Binding HasPendingChanges}" Click="OnResetAllSaveChanges" Padding="8,4" MinWidth="70" Margin="6,0,0,0"/></Grid><ListBox ItemsSource="{Binding PendingChanges}" MaxHeight="130" Margin="0,7,0,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="2"><TextBlock Text="{Binding DisplayPath}" FontFamily="Consolas" TextTrimming="CharacterEllipsis"/><TextBlock Foreground="#AEB7C6" TextTrimming="CharacterEllipsis"><Run Text="{Binding OriginalValue, Mode=OneWay}"/><Run Text="  →  "/><Run Text="{Binding ProposedValue, Mode=OneWay}"/></TextBlock></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel></ScrollViewer></Border>
                    </Grid>
                    <Grid Grid.Row="7" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Backup-first write · source fingerprint re-check · atomic replacement · post-write verification" Foreground="#75D695" VerticalAlignment="Center"/><Button Grid.Column="1" Content="Apply save changes…" IsEnabled="{Binding CanApply}" Click="OnApplySaveChanges" Padding="14,7"/></Grid>
                </Grid>
            </TabItem>
            <TabItem Header="Database setup">
                <Grid Margin="14">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox Text="{Binding DatabasePath, Mode=OneWay}" IsReadOnly="True" Padding="10,7" Background="#1B2029" Foreground="#E8ECF3" BorderBrush="#343C49"/>
                        <Button Grid.Column="1" Content="Browse…" Margin="10,0,0,0" IsEnabled="{Binding CanInteract}" Click="OnBrowse"/>
                        <Button Grid.Column="2" Content="Find database" Margin="8,0,0,0" IsEnabled="{Binding CanInteract}" Click="OnDiscover"/>
                        <Button Grid.Column="3" Content="Validate and reload" Margin="8,0,0,0" IsEnabled="{Binding HasDatabasePath}" Click="OnValidate"/>
                    </Grid>
                    <Border Grid.Row="2" Padding="12" CornerRadius="6" Background="#1B2029" BorderBrush="#343C49" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="290"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="{Binding StatusTitle}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding StatusDetails}" Margin="0,4,0,0" Foreground="#C5CCD7" TextWrapping="Wrap"/></StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding MetadataDetails}" Foreground="#C5CCD7" TextWrapping="Wrap" LineHeight="18" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <TabControl Grid.Row="4" Background="#171B22" BorderBrush="#343C49">
                        <TabItem Header="Browse settings">
                            <Grid Margin="12">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="10,7" ToolTip="Search keys, values, and source tables"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding Types}" SelectedItem="{Binding SelectedType}" Margin="10,0,0,0" Padding="7"/>
                                    <ComboBox Grid.Column="2" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" Margin="10,0,0,0" Padding="7"/>
                                </Grid>
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="2.2*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                        <TextBlock Text="{Binding SettingsSummary}" Foreground="#AEB7C6"/>
                                        <DataGrid Grid.Row="2" ItemsSource="{Binding SettingsView}" SelectedItem="{Binding SelectedSetting}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Setting" Binding="{Binding Label}" Width="*" SortMemberPath="Label"/>
                                                <DataGridTextColumn Header="Display value" Binding="{Binding DisplayValueWithUnits}" Width="160" SortMemberPath="DisplayValue"/>
                                                <DataGridTextColumn Header="Raw value" Binding="{Binding RawValue}" Width="170" SortMemberPath="RawValue"/>
                                                <DataGridTextColumn Header="Type" Binding="{Binding TypeLabel}" Width="85" SortMemberPath="TypeLabel"/>
                                                <DataGridTextColumn Header="Source" Binding="{Binding SourceTable}" Width="155" SortMemberPath="SourceTable"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                    <Border Grid.Column="2" Padding="16" Background="#1B2029" BorderBrush="#343C49" BorderThickness="1" CornerRadius="5">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                                            <TextBlock Text="Setting details" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                            <TextBlock Text="{Binding SelectedSetting.Label, TargetNullValue=Select a setting}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding SelectedSetting.Key, StringFormat=Database key: {0}}" Foreground="#AEB7C6" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding SelectedSetting.DisplayValueWithUnits, StringFormat=Display value: {0}}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding SelectedSetting.RawValue, StringFormat=Exact raw value: {0}}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding SelectedSetting.RawUnits, StringFormat=Raw units: {0}}" Margin="0,5,0,0"/>
                                            <TextBlock Text="{Binding SelectedSetting.TypeLabel, StringFormat=Type: {0}}" Margin="0,5,0,0"/>
                                            <TextBlock Text="{Binding SelectedSetting.SourceTable, StringFormat=Source: {0}}" Margin="0,5,0,0"/>
                                            <Separator Margin="0,14"/>
                                            <TextBlock Text="{Binding SelectedSetting.Description}" Foreground="#C5CCD7" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding SelectedSetting.Units, StringFormat=Units: {0}}" Margin="0,10,0,0"/>
                                            <TextBlock Text="{Binding SelectedSetting.RiskLevel, StringFormat=Risk: {0}}" Margin="0,5,0,0" Foreground="#FFB55A"/>
                                            <TextBlock Text="{Binding SelectedSetting.DocumentationStatus, StringFormat=Status: {0}}" Margin="0,5,0,0" Foreground="#FFB55A"/>
                                            <Separator Margin="0,14"/>
                                            <TextBlock Text="Stage a change" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding EditorLabel}" Foreground="#AEB7C6" Margin="0,5,0,0"/>
                                            <TextBox Text="{Binding ProposedValue, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,0" Padding="8,5" ToolTip="Integer and float values use invariant formatting; staged values are not written to the database."/>
                                            <TextBlock Text="{Binding EditorError}" Foreground="#FF7770" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                            <TextBlock Text="{Binding EditorWarning}" Foreground="#FFB55A" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Button Content="Stage change" IsEnabled="{Binding CanStageSelected}" Click="OnStageChange"/><Button Content="Reset" IsEnabled="{Binding HasSelectedSetting}" Click="OnResetSelectedChange" Margin="8,0,0,0"/></StackPanel>
                                            <Button Content="{Binding FavoriteButtonText}" IsEnabled="{Binding HasSelectedSetting}" Click="OnToggleFavorite" Margin="0,12,0,0" HorizontalAlignment="Left"/>
                                            <Separator Margin="0,14"/>
                                            <TextBlock Text="Favorites" FontWeight="SemiBold"/>
                                            <ListBox ItemsSource="{Binding FavoriteSettings}" SelectedItem="{Binding SelectedSetting}" DisplayMemberPath="Label" MaxHeight="90" Margin="0,5,0,0"/>
                                            <TextBlock Text="Recently viewed" FontWeight="SemiBold" Margin="0,12,0,0"/>
                                            <ListBox ItemsSource="{Binding RecentSettings}" SelectedItem="{Binding SelectedSetting}" DisplayMemberPath="Label" MaxHeight="110" Margin="0,5,0,0"/>
                                        </StackPanel></ScrollViewer>
                                    </Border>
                                </Grid>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Staged changes">
                            <Grid Margin="12">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="In-memory diff" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="These changes have not been written to masters.db. Applying changes and backups arrive in a later milestone." Foreground="#AEB7C6" Margin="0,4,0,0"/></StackPanel><Button Grid.Column="1" Content="Reset all" IsEnabled="{Binding HasPendingChanges}" Click="OnResetAllChanges" VerticalAlignment="Center"/></Grid>
                                <DataGrid Grid.Row="2" ItemsSource="{Binding PendingChanges}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"><DataGrid.Columns><DataGridTextColumn Header="Setting" Binding="{Binding SettingLabel}" Width="*"/><DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="250"/><DataGridTextColumn Header="Original raw value" Binding="{Binding OriginalRawValue}" Width="170"/><DataGridTextColumn Header="Proposed raw value" Binding="{Binding ProposedRawValue}" Width="170"/><DataGridTextColumn Header="Warnings" Binding="{Binding WarningSummary}" Width="2*"/></DataGrid.Columns></DataGrid>
                                <TextBlock Grid.Row="3" Text="Read-only database access · staged changes are kept only for this running session" Foreground="#75D695" Margin="0,10,0,0"/>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Schema">
                            <Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <ListBox ItemsSource="{Binding SchemaTables}" SelectedItem="{Binding SelectedSchemaTable}" SelectionChanged="OnSchemaSelectionChanged" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Summary}" Foreground="#7E8999" FontSize="11"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
                                <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="150"/><RowDefinition Height="10"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="{Binding SchemaSummary}" Foreground="#AEB7C6" TextWrapping="Wrap"/><DataGrid Grid.Row="2" ItemsSource="{Binding SelectedSchemaTable.Columns}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="#" Binding="{Binding Ordinal}" Width="45"/><DataGridTextColumn Header="Column" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Declared type" Binding="{Binding DeclaredType}" Width="130"/><DataGridCheckBoxColumn Header="Nullable" Binding="{Binding IsNullable}" Width="75"/><DataGridCheckBoxColumn Header="Primary key" Binding="{Binding IsPrimaryKey}" Width="85"/></DataGrid.Columns></DataGrid><ListBox Grid.Row="4" ItemsSource="{Binding PreviewRows}" ScrollViewer.HorizontalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayValue}" FontFamily="Consolas" FontSize="12"/></DataTemplate></ListBox.ItemTemplate></ListBox></Grid>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </TabItem>
            <TabItem Header="App settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="24" MaxWidth="860" HorizontalAlignment="Left"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel><TextBlock Text="Application settings" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Manage the preferences this utility stores locally on this computer." Foreground="#AEB7C6" Margin="0,4,0,0"/></StackPanel>
                    <Border Grid.Row="2" Padding="18" Background="#1B2029" BorderBrush="#343C49" BorderThickness="1" CornerRadius="6"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Saved preferences" FontSize="17" FontWeight="SemiBold"/>
                        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Remembered database" FontWeight="SemiBold"/><TextBlock Text="{Binding RememberedDatabasePath}" Foreground="#AEB7C6" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel><Button Grid.Column="1" Content="Forget database" IsEnabled="{Binding CanInteract}" Click="OnForgetRememberedDatabase" VerticalAlignment="Center" Margin="16,0,0,0"/></Grid>
                        <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Favorite settings" FontWeight="SemiBold"/><TextBlock Text="{Binding FavoriteCount, StringFormat={}{0:N0} saved favorite(s)}" Foreground="#AEB7C6" Margin="0,4,0,0"/></StackPanel><Button Grid.Column="1" Content="Clear favorites" IsEnabled="{Binding CanInteract}" Click="OnClearFavorites" VerticalAlignment="Center" Margin="16,0,0,0"/></Grid>
                        <Grid Grid.Row="6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Recently viewed settings" FontWeight="SemiBold"/><TextBlock Text="{Binding RecentSettingsCount, StringFormat={}{0:N0} saved item(s)}" Foreground="#AEB7C6" Margin="0,4,0,0"/></StackPanel><Button Grid.Column="1" Content="Clear history" IsEnabled="{Binding CanInteract}" Click="OnClearRecentSettings" VerticalAlignment="Center" Margin="16,0,0,0"/></Grid>
                    </Grid></Border>
                    <Border Grid.Row="4" Padding="18" Background="#1B2029" BorderBrush="#343C49" BorderThickness="1" CornerRadius="6"><StackPanel><TextBlock Text="Storage and safeguards" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{Binding PreferencesFilePath}" Foreground="#AEB7C6" Margin="0,8,0,0" TextWrapping="Wrap"/><TextBlock Text="Database access is always read-only. Save changes are only written after you confirm them, with a verified backup created first." Foreground="#C5CCD7" Margin="0,10,0,0" TextWrapping="Wrap"/></StackPanel></Border>
                </Grid></ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
