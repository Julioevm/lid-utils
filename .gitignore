# Local application state
*.user
*.suo
*.log
settings.local.json
backups/

# Never commit game databases or their sidecar/backup files
*.db
*.db-shm
*.db-wal
*.db-journal
*.db.bak
*.sav
*.sav.bak

# Public sample exports (sanitized copies: personal identifiers removed).
# Raw exports and backups stay ignored under /data/private and elsewhere.
/data/*
!/data/save_current.json
!/data/save_progress.json
