<Window x:Class="LidUtils.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:app="clr-namespace:LidUtils.App"
        Title="LET IT DIE Utilities" Width="1240" Height="820" MinWidth="960" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="#11141A" Foreground="#F4F6FA" Loaded="OnLoaded" Closing="OnClosing">
    <Window.Resources>
        <DataTemplate DataType="{x:Type app:SaveNumericFieldRow}">
            <Border Margin="0,8,0,0" Padding="12,9" CornerRadius="4" Background="#161B23" BorderBrush="#2A313D" BorderThickness="1">
                <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#161B23"/><Setter Property="BorderBrush" Value="#2A313D"/><Style.Triggers><DataTrigger Binding="{Binding IsStaged}" Value="True"><Setter Property="Background" Value="#6B5715"/><Setter Property="BorderBrush" Value="#8A7420"/></DataTrigger></Style.Triggers></Style></Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Label}" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" Foreground="#AEB7C6" FontSize="11" TextWrapping="Wrap" MaxWidth="380" HorizontalAlignment="Left" Margin="0,3,12,0" ToolTip="{Binding DetailsToolTip}"/></StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0"><TextBlock Text="Current" Foreground="#7E8999" FontSize="11" HorizontalAlignment="Right"/><TextBlock Text="{Binding CurrentValue}" HorizontalAlignment="Right"/></StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="14,0,0,0"><TextBlock Text="New value" Foreground="#7E8999" FontSize="11" HorizontalAlignment="Right"/><TextBox Width="170" Margin="0,3,0,0" Padding="7,4" Text="{Binding DraftValue, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding DetailsToolTip}" IsEnabled="{Binding DataContext.CanInteract, RelativeSource={RelativeSource AncestorType={x:Type TabControl}}}"/><TextBlock Text="{Binding ValidationError}" Foreground="#FF7770" FontSize="11" TextWrapping="Wrap" MaxWidth="170" HorizontalAlignment="Right" Margin="0,3,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding ValidationError}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel>
                    <Button Grid.Column="3" Content="Undo" Click="OnUndoSaveField" VerticalAlignment="Center" Margin="10,0,0,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="MinWidth" Value="0"/><Setter Property="Padding" Value="7,3"/><Setter Property="Margin" Value="0"/><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsStaged}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="LET IT DIE" FontSize="13" FontWeight="SemiBold" Foreground="#FF5A52"/>
                <TextBlock Text="Utilities" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock Text="Database setup, save editing, and application preferences." Foreground="#AEB7C6"/>
            </StackPanel>
            <ProgressBar Grid.Column="1" Width="150" Height="5" IsIndeterminate="True" VerticalAlignment="Center" Visibility="{Binding BusyVisibility}"/>
        </Grid>
        <TabControl Grid.Row="2" Background="#171B22" BorderBrush="#343C49">
            <TabItem Header="Save editor">
                <Grid Margin="14" DataContext="{Binding SaveEditor}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding SavePath, Mode=OneWay}" IsReadOnly="True" Padding="10,7" Background="#1B2029" Foreground="#E8ECF3" BorderBrush="#343C49"/><Button Grid.Column="1" Content="Browse…" Margin="10,0,0,0" IsEnabled="{Binding CanInteract}" Click="OnBrowseSave"/><Button Grid.Column="2" Content="Reload" Margin="8,0,0,0" IsEnabled="{Binding CanInteract}" Click="OnReloadSave"/><Button Grid.Column="3" Content="Export JSON…" Margin="8,0,0,0" IsEnabled="{Binding CanExportJson}" Click="OnExportSaveJson"/><Button Grid.Column="4" Content="ⓘ" FontSize="12" Width="34" Height="34" MinWidth="0" Padding="0" Margin="8,0,0,0" ToolTip="Save file details" IsEnabled="{Binding HasSnapshot}" Click="OnShowSaveInfo"/></Grid>
                    <TabControl Grid.Row="2" Background="#171B22" BorderBrush="#343C49">
                        <TabItem Header="Overview">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="20" MaxWidth="980" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Overview.Title}" FontSize="22" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Overview.Description}" Foreground="#AEB7C6" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    <ItemsControl ItemsSource="{Binding Overview.Sections}" Margin="0,16,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="290" MinHeight="170" Margin="0,0,12,12" Padding="16" CornerRadius="5" Background="#1B2029" BorderBrush="#343C49" BorderThickness="1">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="#FFB55A"/>
                                                        <ItemsControl ItemsSource="{Binding Values}" Margin="0,8,0,0">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid Margin="0,4,0,0">
                                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                                        <TextBlock Text="{Binding Label}" Foreground="#AEB7C6"/>
                                                                        <TextBlock Grid.Column="1" Text="{Binding Value}" FontWeight="SemiBold" Margin="12,0,0,0" TextAlignment="Right" TextWrapping="Wrap" MaxWidth="150"/>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Border Margin="0,4,0,0" Padding="12" CornerRadius="5" Background="#161B23" BorderBrush="#2A313D" BorderThickness="1">
                                        <TextBlock Text="Overview values are read-only and calculated from save data. They are not included in staged changes." Foreground="#7E8999" TextWrapping="Wrap"/>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="Currency">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="12" MaxWidth="860" HorizontalAlignment="Left">
                                    <TextBlock Text="Currency" FontSize="17" FontWeight="SemiBold"/>
                                    <TextBlock Text="Edit the currencies and progression values stored in this save. Changes are staged and written only after Apply save changes is confirmed." Foreground="#AEB7C6" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    <TextBlock Text="Load a save to edit its values." Foreground="#AEB7C6" Margin="0,4,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding HasSnapshot}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                    <Border Margin="0,10,0,0" Padding="14,12" CornerRadius="5" Background="#1B2029" BorderBrush="#343C49" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="Currencies" FontSize="15" FontWeight="SemiBold"/>
                                            <ItemsControl ItemsSource="{Binding Currencies}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Margin="0,10,0,0" Padding="14,12" CornerRadius="5" Background="#1B2029" BorderBrush="#343C49" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="Waiting room" FontSize="15" FontWeight="SemiBold"/>
                                            <ItemsControl ItemsSource="{Binding WaitingRoomFields}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Margin="0,10,0,0" Padding="14,12" CornerRadius="5" Background="#1B2029" BorderBrush="#343C49" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="VIP Royal Express" FontSize="15" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Vip.StatusText}" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                            <TextBlock Text="{Binding Vip.ExpiresText}" Foreground="#7E8999" FontSize="11" Margin="0,2,0,0"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0"><StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding Vip.IsAvailable}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                                <TextBlock Text="Days" VerticalAlignment="Center"/>
                                                <ComboBox x:Name="VipDaysCombo" ItemsSource="{Binding Vip.DaysOptions}" SelectedItem="{Binding Vip.SelectedDays}" Width="80" Margin="8,0,0,0" IsEnabled="{Binding CanInteract}"/>
                                                <TextBlock Text="Reserve passes" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                                <TextBox Width="70" Margin="8,0,0,0" Padding="7,4" Text="{Binding Vip.ReservePassesText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanInteract}" ToolTip="Stored 30-day and 1-day Royal Express passes staged on activation (0 to 99)."/>
                                                <Button Content="Activate VIP…" Click="OnActivateVip" Margin="14,0,0,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding Vip.IsStaged}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                                                <Button Content="Deactivate" Click="OnDeactivateVip" Margin="8,0,0,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Vip.IsStaged}" Value="False"/><Condition Binding="{Binding Vip.IsActive}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></Button.Style></Button>
                                                <Button Content="Undo VIP changes" Click="OnUndoVip" Margin="8,0,0,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Vip.IsStaged}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Vip.DaysHint}" Foreground="#FFB55A" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Vip.IsAvailable}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                            <TextBlock Text="{Binding Vip.ValidationError}" Foreground="#FF7770" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Vip.ValidationError}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                            <TextBlock Text="This save does not contain the Royal Express pass values, so VIP changes cannot be staged." Foreground="#7E8999" FontSize="11" Margin="0,8,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Vip.IsAvailable}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                            <TextBlock Text="VIP changes are staged below. Undo them before applying if needed." Foreground="#7E8999" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Vip.IsStaged}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                        </StackPanel>
                                    </Border>
                                    <Border Margin="0,10,0,0" Padding="14,12" CornerRadius="5" Background="#1B2029" BorderBrush="#343C49" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="Account perks" FontSize="15" FontWeight="SemiBold"/>
                                            <ItemsControl ItemsSource="{Binding AccountFields}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="All values">
                            <Grid Margin="12">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="10,7" ToolTip="Search JSON path or value"/>
                                    <CheckBox Grid.Column="1" Content="Favorites only" IsChecked="{Binding IsFavoritesOnly}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    <ToggleButton Grid.Column="2" Content="Show staged changes" IsChecked="{Binding IsShowingStagedChanges}" IsEnabled="{Binding CanShowStagedChanges}" Margin="12,0,0,0" Padding="10,7"/>
                                    <Button Grid.Column="3" Content="Clear filter" IsEnabled="{Binding HasSearchText}" Click="OnClearSaveSearch" Margin="8,0,0,0"/>
                                    <TextBlock Grid.Column="4" Text="{Binding ValuesSummary}" Foreground="#AEB7C6" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                </Grid>
                                <DataGrid Grid.Row="2" ItemsSource="{Binding DisplayedValues}" IsReadOnly="False" IsEnabled="{Binding CanInteract}" AutoGenerateColumns="False" CanUserAddRows="False" EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                            <Style.Triggers><DataTrigger Binding="{Binding IsStaged}" Value="True"><Setter Property="Background" Value="#6B5715"/></DataTrigger></Style.Triggers>
                                        </Style>
                                    </DataGrid.RowStyle>
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="★" Width="42" IsReadOnly="True">
                                            <DataGridTemplateColumn.CellTemplate><DataTemplate><Button Click="OnToggleSaveFavorite" ToolTip="Toggle favorite"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Content" Value="☆"/><Setter Property="Width" Value="28"/><Setter Property="MinWidth" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Style.Triggers><DataTrigger Binding="{Binding IsFavorite}" Value="True"><Setter Property="Content" Value="★"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="JSON path" Width="*" IsReadOnly="True" SortMemberPath="DisplayPath"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding DisplayPath}" ToolTip="{Binding DetailsToolTip}" TextTrimming="CharacterEllipsis"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Current value" Binding="{Binding CurrentValue}" Width="220" IsReadOnly="True" SortMemberPath="CurrentValue"/>
                                        <DataGridTemplateColumn Header="New value" Width="260">
                                            <DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><TextBox Text="{Binding DraftValue, UpdateSourceTrigger=PropertyChanged}" Padding="6,2"/><TextBlock Text="{Binding ValidationError}" Foreground="#FF7770" TextWrapping="Wrap" Margin="0,3,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding ValidationError}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="" Width="72" IsReadOnly="True">
                                            <DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="Undo" Click="OnUndoSaveChange"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="MinWidth" Value="0"/><Setter Property="Padding" Value="7,3"/><Setter Property="Margin" Value="0"/><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsStaged}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>
                    </TabControl>
                    <Grid Grid.Row="3" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Backup-first write · source fingerprint re-check · atomic replacement · post-write verification" Foreground="#75D695"/><TextBlock Text="{Binding PendingChanges.Count, StringFormat={}{0:N0} staged change(s)}" Foreground="#AEB7C6" Margin="0,3,0,0"/></StackPanel>
                        <Button Grid.Column="1" Content="Apply save changes…" IsEnabled="{Binding CanApply}" Click="OnApplySaveChanges" Margin="8,0,0,0" Padding="14,7"/>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="Game Database">
                <Grid Margin="14">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox Text="{Binding DatabasePath, Mode=OneWay}" IsReadOnly="True" Padding="10,7" Background="#1B2029" Foreground="#E8ECF3" BorderBrush="#343C49"/>
                        <Button Grid.Column="1" Content="Browse…" Margin="10,0,0,0" IsEnabled="{Binding CanInteract}" Click="OnBrowse"/>
                        <Button Grid.Column="2" Content="Find database" Margin="8,0,0,0" IsEnabled="{Binding CanInteract}" Click="OnDiscover"/>
                        <Button Grid.Column="3" Content="Validate and reload" Margin="8,0,0,0" IsEnabled="{Binding HasDatabasePath}" Click="OnValidate"/>
                        <Button Grid.Column="4" Content="ⓘ" FontSize="12" Width="34" Height="34" MinWidth="0" Padding="0" Margin="8,0,0,0" ToolTip="Game database details" IsEnabled="{Binding HasDatabasePath}" Click="OnShowDatabaseInfo"/>
                    </Grid>
                    <TabControl Grid.Row="2" Background="#171B22" BorderBrush="#343C49">
                        <TabItem Header="Browse settings">
                            <Grid Margin="12">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="170"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="10,7" ToolTip="Search keys, values, and source tables"/>
                                    <CheckBox Grid.Column="1" Content="Favorites only" IsChecked="{Binding IsFavoritesOnly}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    <ComboBox Grid.Column="2" ItemsSource="{Binding Types}" SelectedItem="{Binding SelectedType}" Margin="10,0,0,0" Padding="7"/>
                                    <ComboBox Grid.Column="3" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" Margin="10,0,0,0" Padding="7"/>
                                </Grid>
                                <Grid Grid.Row="2">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                    <TextBlock Text="{Binding SettingsSummary}" Foreground="#AEB7C6"/>
                                    <DataGrid Grid.Row="2" ItemsSource="{Binding SettingsView}" IsReadOnly="False" IsEnabled="{Binding CanInteract}" AutoGenerateColumns="False" CanUserAddRows="False" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                        <DataGrid.RowStyle><Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}"><Style.Triggers><DataTrigger Binding="{Binding IsStaged}" Value="True"><Setter Property="Background" Value="#6B5715"/></DataTrigger></Style.Triggers></Style></DataGrid.RowStyle>
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="★" Width="42" IsReadOnly="True"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Click="OnToggleDatabaseFavorite" ToolTip="Toggle favorite"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Content" Value="☆"/><Setter Property="Width" Value="28"/><Setter Property="MinWidth" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Style.Triggers><DataTrigger Binding="{Binding IsFavorite}" Value="True"><Setter Property="Content" Value="★"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Setting" Width="*" IsReadOnly="True"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Label}" ToolTip="{Binding DetailsToolTip}" TextTrimming="CharacterEllipsis"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Raw value" Binding="{Binding RawValue}" Width="170" IsReadOnly="True" SortMemberPath="RawValue"/>
                                            <DataGridTemplateColumn Header="New value" Width="230"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><TextBox Text="{Binding DraftValue, UpdateSourceTrigger=PropertyChanged}" Padding="6,2" ToolTip="Staged in memory after a short pause; integer and float values use invariant formatting."/><TextBlock Text="{Binding ValidationError}" Foreground="#FF7770" TextWrapping="Wrap" Margin="0,3,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding ValidationError}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock Text="{Binding Warning}" Foreground="#FFB55A" TextWrapping="Wrap" Margin="0,3,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Warning}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="" Width="72" IsReadOnly="True"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="Undo" Click="OnUndoDatabaseChange"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="MinWidth" Value="0"/><Setter Property="Padding" Value="7,3"/><Setter Property="Margin" Value="0"/><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsStaged}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Grid>
                        </TabItem>
                        <TabItem>
                            <TabItem.Header><TextBlock Text="Staged changes"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type TabItem}}}" Value="True"><Setter Property="Foreground" Value="{StaticResource TextBrush}"/></DataTrigger><DataTrigger Binding="{Binding HasPendingChanges}" Value="True"><Setter Property="Foreground" Value="#FFB55A"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></TabItem.Header>
                            <Grid Margin="12">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Review database changes" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Applying creates and verifies a full database backup before one atomic transaction." Foreground="#AEB7C6" Margin="0,4,0,0"/></StackPanel><Button Grid.Column="1" Content="Reset all" IsEnabled="{Binding HasPendingChanges}" Click="OnResetAllChanges" VerticalAlignment="Center"/><Button Grid.Column="2" Content="Apply database changes…" IsEnabled="{Binding CanApplyDatabaseChanges}" Click="OnApplyDatabaseChanges" VerticalAlignment="Center" Margin="8,0,0,0" Padding="14,7"/></Grid>
                                <DataGrid Grid.Row="2" ItemsSource="{Binding ChangeReviewRows}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"><DataGrid.Columns><DataGridTextColumn Header="Setting" Binding="{Binding SettingLabel}" Width="*"/><DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="250"/><DataGridTextColumn Header="Original raw value" Binding="{Binding OriginalRawValue}" Width="170"/><DataGridTextColumn Header="Proposed raw value" Binding="{Binding ProposedRawValue}" Width="170"/><DataGridTextColumn Header="Warnings" Binding="{Binding WarningSummary}" Width="2*"/></DataGrid.Columns></DataGrid>
                                <TextBlock Grid.Row="3" Text="All listed constant settings can be applied · LET IT DIE must be closed · verified backup and audit record included" Foreground="#75D695" Margin="0,10,0,0"/>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Backups">
                            <Grid Margin="12">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <StackPanel><TextBlock Text="Database backups" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Backups for the selected masters.db are shown here. Backups from an older game schema cannot be restored." Foreground="#AEB7C6" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel>
                                <DataGrid Grid.Row="2" ItemsSource="{Binding DatabaseBackups}" SelectedItem="{Binding SelectedDatabaseBackup}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Created" Binding="{Binding Created}" Width="170"/><DataGridTextColumn Header="Purpose" Binding="{Binding Purpose}" Width="150"/><DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="100"/><DataGridTextColumn Header="Fingerprint" Binding="{Binding Fingerprint}" Width="150"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/></DataGrid.Columns></DataGrid>
                                <Grid Grid.Row="3" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Restore first creates a verified backup of the current database." Foreground="#75D695" VerticalAlignment="Center"/><Button Grid.Column="1" Content="Restore selected backup…" IsEnabled="{Binding CanRestoreDatabaseBackup}" Click="OnRestoreDatabaseBackup" Padding="14,7"/></Grid>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Advanced">
                            <Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <ListBox ItemsSource="{Binding SchemaTables}" SelectedItem="{Binding SelectedSchemaTable}" SelectionChanged="OnSchemaSelectionChanged" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Summary}" Foreground="#7E8999" FontSize="11"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
                                <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="150"/><RowDefinition Height="10"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="{Binding SchemaSummary}" Foreground="#AEB7C6" TextWrapping="Wrap"/><DataGrid Grid.Row="2" ItemsSource="{Binding SelectedSchemaTable.Columns}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="#" Binding="{Binding Ordinal}" Width="45"/><DataGridTextColumn Header="Column" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Declared type" Binding="{Binding DeclaredType}" Width="130"/><DataGridCheckBoxColumn Header="Nullable" Binding="{Binding IsNullable}" Width="75"/><DataGridCheckBoxColumn Header="Primary key" Binding="{Binding IsPrimaryKey}" Width="85"/></DataGrid.Columns></DataGrid><DataGrid x:Name="AdvancedTableGrid" Grid.Row="4" ItemsSource="{Binding PreviewRows}" IsReadOnly="False" AutoGenerateColumns="False" CanUserAddRows="False" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.HorizontalScrollBarVisibility="Auto"><DataGrid.RowStyle><Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}"><Style.Triggers><DataTrigger Binding="{Binding IsStaged}" Value="True"><Setter Property="Background" Value="#6B5715"/></DataTrigger></Style.Triggers></Style></DataGrid.RowStyle></DataGrid></Grid>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </TabItem>
            <TabItem Header="App settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="24" MaxWidth="860" HorizontalAlignment="Left"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel><TextBlock Text="Application settings" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Manage the preferences this utility stores locally on this computer." Foreground="#AEB7C6" Margin="0,4,0,0"/></StackPanel>
                    <Border Grid.Row="2" Padding="18" Background="#1B2029" BorderBrush="#343C49" BorderThickness="1" CornerRadius="6"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Saved preferences" FontSize="17" FontWeight="SemiBold"/>
                        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Game installation" FontWeight="SemiBold"/><TextBlock Text="{Binding GameInstallPath}" Foreground="#AEB7C6" TextWrapping="Wrap" Margin="0,4,0,0"/><TextBlock Text="{Binding GameInstallDetails}" Foreground="#7E8999" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel><Button Grid.Column="1" Content="Change…" IsEnabled="{Binding CanInteract}" Click="OnChangeGameInstallPath" VerticalAlignment="Center" Margin="16,0,0,0"/></Grid>
                        <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Remembered database" FontWeight="SemiBold"/><TextBlock Text="{Binding RememberedDatabasePath}" Foreground="#AEB7C6" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel><Button Grid.Column="1" Content="Forget database" IsEnabled="{Binding CanInteract}" Click="OnForgetRememberedDatabase" VerticalAlignment="Center" Margin="16,0,0,0"/></Grid>
                        <Grid Grid.Row="6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Favorite settings" FontWeight="SemiBold"/><TextBlock Text="{Binding FavoriteCount, StringFormat={}{0:N0} saved favorite(s)}" Foreground="#AEB7C6" Margin="0,4,0,0"/></StackPanel><Button Grid.Column="1" Content="Clear favorites" IsEnabled="{Binding CanInteract}" Click="OnClearFavorites" VerticalAlignment="Center" Margin="16,0,0,0"/></Grid>
                        <Grid Grid.Row="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Database backup limit" FontWeight="SemiBold"/><TextBlock Text="Newest backups kept globally after the next successful apply or restore (1–50)." Foreground="#AEB7C6" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel><TextBox x:Name="DatabaseBackupRetentionText" Grid.Column="1" Text="{Binding DatabaseBackupRetentionCount, Mode=OneWay}" Width="64" Padding="8,5" VerticalAlignment="Center" Margin="16,0,0,0"/><Button Grid.Column="2" Content="Save limit" IsEnabled="{Binding CanInteract}" Click="OnSaveDatabaseBackupLimit" VerticalAlignment="Center" Margin="8,0,0,0"/></Grid>
                    </Grid></Border>
                    <Border Grid.Row="4" Padding="18" Background="#1B2029" BorderBrush="#343C49" BorderThickness="1" CornerRadius="6"><StackPanel><TextBlock Text="Storage and safeguards" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{Binding PreferencesFilePath}" Foreground="#AEB7C6" Margin="0,8,0,0" TextWrapping="Wrap"/><TextBlock Text="Database and save changes are written only after confirmation and a verified backup. Database writes are transactional and followed by integrity verification." Foreground="#C5CCD7" Margin="0,10,0,0" TextWrapping="Wrap"/></StackPanel></Border>
                </Grid></ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
