<UserControl x:Class="LidUtils.App.MapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:LidUtils.App">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Rotation" Foreground="#AEB7C6" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox Width="86"
                          ItemsSource="{Binding TemplateOptions}"
                          SelectedItem="{Binding SelectedTemplate}"
                          Padding="7,5"
                          ToolTip="The daily map rotation. Each rotation mounts its own side areas and connections."/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                <TextBlock Text="Band" Foreground="#AEB7C6" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox Width="210"
                          ItemsSource="{Binding BandOptions}"
                          SelectedItem="{Binding SelectedBand}"
                          DisplayMemberPath="Label"
                          Padding="7,5"
                          ToolTip="Show the whole tower or a single themed band. Heaven (F51+) is a later iteration."/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                <Button Content="Today" Padding="12,6" MinWidth="70" Margin="0,0,8,0"
                        Click="OnTodayClicked"
                        ToolTip="Jump to the rotation the term calendar says is live now"/>
                <CheckBox Content="Area labels" IsChecked="{Binding ShowAreaLabels}" VerticalAlignment="Center"
                          ToolTip="Show short area ids next to dots when they fit without overlapping"/>
            </StackPanel>
            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0"
                        Visibility="{Binding HasData, Converter={StaticResource BoolToVis}}">
                <TextBlock FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#AEB7C6">
                    <Run Text="●" Foreground="#5CB0FF"/> <Run Text="Metro" Foreground="#8A94A6"/><Run Text="  "/>
                    <Run Text="●" Foreground="#63C763"/> <Run Text="Arcade" Foreground="#8A94A6"/><Run Text="  "/>
                    <Run Text="●" Foreground="#C47BD9"/> <Run Text="Amusement" Foreground="#8A94A6"/><Run Text="  "/>
                    <Run Text="●" Foreground="#F0A24A"/> <Run Text="Rooftop" Foreground="#8A94A6"/><Run Text="  "/>
                    <Run Text="●" Foreground="#E4587A"/> <Run Text="Hazama" Foreground="#8A94A6"/>
                </TextBlock>
            </StackPanel>
            <TextBlock Grid.Column="4" Text="{Binding NodeCountText}" Foreground="#AEB7C6"
                       VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="11"/>
        </Grid>

        <!-- Status line -->
        <Border Grid.Row="1" Margin="0,8,0,0" Padding="10,7" CornerRadius="4"
                Background="#161B23" BorderBrush="#2A313D" BorderThickness="1">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding StatusTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding RotationSummary}" Foreground="#E8C36A" Margin="14,0,0,0"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{Binding HasData, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
                <TextBlock Text="{Binding StatusDetails}" Foreground="#AEB7C6" FontSize="11" Margin="0,3,0,0"
                           TextWrapping="Wrap"/>
                <ItemsControl ItemsSource="{Binding Warnings}" Margin="0,3,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Foreground="#FFB55A" FontSize="11" TextWrapping="Wrap"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Map + details -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>
            <Border Background="#0F1319" BorderBrush="#2A313D" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
                <ScrollViewer x:Name="MapScrollViewer"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              PanningMode="None">
                    <Canvas x:Name="MapCanvas" Background="Transparent" MinWidth="300" MinHeight="120"
                            MouseLeftButtonDown="OnCanvasMouseLeftButtonDown"
                            MouseLeftButtonUp="OnCanvasMouseLeftButtonUp"
                            MouseMove="OnCanvasMouseMove"
                            MouseLeave="OnCanvasMouseLeave"/>
                </ScrollViewer>
            </Border>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="Areas in view" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock Text="Areas mounted by the selected rotation; click a row to inspect it."
                               Foreground="#AEB7C6" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/>
                </StackPanel>
                <DataGrid Grid.Row="2"
                          ItemsSource="{Binding AreaRows}"
                          SelectedItem="{Binding SelectedArea}"
                          IsReadOnly="True"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          EnableRowVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Floor" Binding="{Binding FloorLabel}" Width="48"/>
                        <DataGridTextColumn Header="Area" Binding="{Binding AreaLabel}" Width="52"/>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Elv" Binding="{Binding ElevatorLabel}" Width="86"/>
                    </DataGrid.Columns>
                </DataGrid>
                <Border Grid.Row="4" Padding="10,9" CornerRadius="4" Background="#161B23"
                        BorderBrush="#2A313D" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding SelectedDetailTitle}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <ScrollViewer Grid.Row="1" MaxHeight="210" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                            <TextBlock Text="{Binding SelectedDetails}" Foreground="#C5CCD7" FontSize="11"
                                       TextWrapping="Wrap" FontFamily="Consolas"/>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Help footer -->
        <TextBlock Grid.Row="5" Foreground="#7E8999" FontSize="11" TextWrapping="Wrap">
            <Run Text="Drag the map to pan. Click an area dot or list row to inspect it. Filled dots are base corridors present in every rotation; hollow diamonds are side areas mounted only by the chosen rotation."/>
            <Run Text=" Coloured rings and matching route lines are elevator services — floors the same car stops at are joined even when no stairs or hatches connect them, and each car has its own colour. The Waiting Room (main elevator) is the hub at the base of the tower."/>
            <Run Text=" The themed bands are shown on a single vertical scale (F1 at the bottom). Heaven (F51–F451) is not included in this iteration." Foreground="#8A6F2F"/>
        </TextBlock>
    </Grid>
</UserControl>
