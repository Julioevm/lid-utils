<Window x:Class="LidUtils.App.ItemCatalogPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:LidUtils.App"
        Title="Select item from catalog"
        Width="880" Height="640"
        MinWidth="700" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="#11141A" Foreground="#F4F6FA">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Select an item" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Text="Browse the installed game catalog. The selected definition ID is returned to the storage operation." Foreground="#AEB7C6" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <app:ItemCatalogView Grid.Row="2" DataContext="{Binding Catalog}"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <TextBlock Text="{Binding Catalog.Status}" Foreground="#FFB55A" VerticalAlignment="Center" Margin="0,0,16,0" TextWrapping="Wrap" MaxWidth="420"/>
            <Button Content="Select" IsEnabled="{Binding Catalog.HasSupportedSelection}" Click="OnSelect" Padding="16,8"/>
            <Button Content="Cancel" IsCancel="True" Margin="8,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
